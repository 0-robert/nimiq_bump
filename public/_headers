/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://rpc.nimiqwatch.com; object-src 'none'; base-uri 'self'; form-action 'none'

# Deliberately no frame-ancestors and no X-Frame-Options: Nimiq Pay renders this
# app inside a WebView, and either header stops it loading at all.
